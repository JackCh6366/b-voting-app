# 複製這個檔案為 .env，再填入實際的值

# 伺服器對外的網址，用來組成短連結
# 本機測試用 http://localhost:3000
# 部署到 Vercel/Render 後，換成你的正式網域
BASE_URL=http://localhost:3000

PORT=3000

# 從 Google Sheet 網址取得，例如：
# https://docs.google.com/spreadsheets/d/【這一段就是 SHEET_ID】/edit
GOOGLE_SHEET_ID=

# AI 輔助建立投票金鑰（選用，有需要使用 AI 圖片分析時再設定）
# 1. Google Gemini API 金鑰（取得方式：https://aistudio.google.com/app/apikey）
GEMINI_API_KEY=

# 2. NVIDIA NIM API 金鑰（取得方式：https://build.nvidia.com/）
NVIDIA_API_KEY=
